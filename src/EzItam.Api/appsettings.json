{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=EzItam;Trusted_Connection=True;TrustServerCertificate=True;",
    "HRIS_Db": "Server=example;Persist Security Info=True;User ID=ViewHrName;Password=example;Encrypt=True;TrustServerCertificate=True;",
    "Hangfire": "Server=localhost;Database=HangFireEZITAM;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": true
  },
  "Seed": {
    "AdminUser": "admin",
    "AdminPassword": "Admin!2345",
    "AdminEmail": "admin@localhost",
    "SampleData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ezitam-api",
    "Audience": "ezitam-clients",
    "Key": "CHANGE-ME-to-a-long-random-secret-at-least-32-chars",
    "ExpiresMinutes": 480
  },
  "Agent": {
    "EnrollmentKey": "change-me-enrollment-key"
  },
  "HangFireJobSetting": {
    "HrSync": {
      "JobId": "sync-hris-employees-weekly",
      "CronExpression": "0 3 * * 0",
      "OrgCode": "HYF"
    }
  }
}
@{
    ViewData["Title"] = L["nav.backgroundjob"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["nav.backgroundjob"]</h1>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0" style="height: calc(100vh - 50px); min-height: 600px;overflow-y:hidden">
        <iframe src="@ViewBag.HangfireUrl"
                style="width: 100%; height: 100%; border: none;"
                title="Hangfire Dashboard">
        </iframe>
    </div>
</div>